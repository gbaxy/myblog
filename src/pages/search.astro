---
import PageLayout from '@layouts/PageLayout.astro';
---
<PageLayout frontmatter={{ title: '搜索', coverTitle: '搜索笔记', comments: false }}>
  <p>搜索文章标题、正文、分类与标签。</p>
  <button class="rounded-lg bg-primary px-5 py-3 text-primary-foreground" data-open-blog-search>搜索文章</button>
</PageLayout>
<script>
  import { openModal } from '@store/modal';
  function installSearchEntry() {
    document.querySelector('[data-open-blog-search]')?.addEventListener('click', () => openModal('search'));
    if (document.querySelector('[data-open-blog-search]')) openModal('search');
  }
  document.addEventListener('astro:page-load', installSearchEntry);
</script>
