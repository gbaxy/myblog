---
import { site } from "../config";

const enabled = Boolean(site.giscus.repo && site.giscus.repoId && site.giscus.categoryId);
---

<section class="comment-section" aria-labelledby="comments-title">
  <h2 id="comments-title">讨论</h2>
  {
    enabled ? (
      <div class="giscus" data-giscus-container></div>
    ) : (
      <p class="comment-note">
        评论将通过 Giscus 承载。部署前请在 <code>src/config.ts</code> 中填写仓库与分类 ID，具体步骤见 README。
      </p>
    )
  }
</section>

{
  enabled && (
    <script
      is:inline
      define:vars={{
        repo: site.giscus.repo,
        repoId: site.giscus.repoId,
        category: site.giscus.category,
        categoryId: site.giscus.categoryId,
      }}
    >
      const giscus = document.createElement("script");
      giscus.src = "https://giscus.app/client.js";
      giscus.async = true;
      giscus.crossOrigin = "anonymous";
      giscus.setAttribute("data-repo", repo);
      giscus.setAttribute("data-repo-id", repoId);
      giscus.setAttribute("data-category", category);
      giscus.setAttribute("data-category-id", categoryId);
      giscus.setAttribute("data-mapping", "pathname");
      giscus.setAttribute("data-reactions-enabled", "1");
      giscus.setAttribute("data-emit-metadata", "0");
      giscus.setAttribute("data-input-position", "top");
      giscus.setAttribute("data-theme", document.documentElement.dataset.theme === "light" ? "light" : "dark");
      giscus.setAttribute("data-lang", "zh-CN");
      document.querySelector("[data-giscus-container]")?.append(giscus);
      window.addEventListener("themechange", () => {
        const frame = document.querySelector("iframe.giscus-frame");
        frame?.contentWindow?.postMessage(
          { giscus: { setConfig: { theme: document.documentElement.dataset.theme === "light" ? "light" : "dark" } } },
          "https://giscus.app",
        );
      });
    </script>
  )
}
